<h1>Create Car</h1>

<form method="post" action="/Cars/Create">
    <div>
        <label>Make</label>
        <input type="text" name="Make" />
    </div>

    <div>
        <label>Model</label>
        <input type="text" name="Model" />
    </div>

    <div>
        <label>Year</label>
        <input type="number" name="Year" />
    </div>

    <button type="submit">Create</button>
</form>
@model CarDealer.Models.Car

<h1>Edit Car</h1>

<form method="post" action="/Cars/Edit">
    <input type="hidden" name="Id" value="@Model.Id" />

    <div>
        <label>Make</label>
        <input type="text" name="Make" value="@Model.Make" />
    </div>

    <div>
        <label>Model</label>
        <input type="text" name="Model" value="@Model.Model" />
    </div>

    <div>
        <label>Year</label>
        <input type="number" name="Year" value="@Model.Year" />
    </div>

    <button type="submit">Save</button>
</form>